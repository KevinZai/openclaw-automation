# OpenClaw Automation — Environment Variables
# Copy this file to .env and fill in your values.
# All variables have sane defaults — you only need to set what differs from your setup.

# ─── Paths ───────────────────────────────────────────────────────────────────
# CLAWD_DIR=~/clawd                     # Base workspace directory
# OPENCLAW_DIR=~/.openclaw              # OpenClaw config directory
# OPENCLAW_AGENTS_DIR=~/.openclaw/agents # Agent session storage
# BACKUP_DIR=~/backups                  # Backup storage directory

# ─── API URLs ────────────────────────────────────────────────────────────────
# PAPERCLIP_URL=http://localhost:3110   # Paperclip task management API
# OLLAMA_URL=http://localhost:11434     # Ollama local LLM API

# ─── OpenClaw IDs ────────────────────────────────────────────────────────────
OPENCLAW_COMPANY_ID=your-company-uuid-here
# OPENCLAW_GN_COMPANY_ID=               # Secondary company (optional)
# OPENCLAW_PROJECT_ID=                   # Default project UUID (optional)
# FLEET_OPS_PROJECT_ID=                  # Fleet operations project (optional)

# ─── Agent IDs (Free Fleet) ─────────────────────────────────────────────────
# AGENT_ID_FORGE=                        # HuggingFace agent UUID
# AGENT_ID_FLARE=                        # Cloudflare Workers agent UUID
# AGENT_ID_LAMA=                         # Ollama agent UUID
# AGENT_ID_ORACLE=                       # Groq agent UUID
# AGENT_ID_CODEX_DEV=                    # Codex dev agent UUID
# AGENT_ID_ATLAS=                        # Atlas worker agent UUID
# AGENT_ID_SCRIBE=                       # Scribe worker agent UUID
# AGENT_ID_PIXEL=                        # Pixel worker agent UUID

# ─── Notifications ───────────────────────────────────────────────────────────
# ALERT_TELEGRAM_CHAT_ID=               # Telegram chat ID for alerts
# TELEGRAM_BOT_TOKEN=                   # Telegram bot token

# ─── Branding ────────────────────────────────────────────────────────────────
# BRAND_NAME=MyBrand                    # Brand name in content tasks
# BRAND_AUDIENCE=customers and prospects # Target audience description
# MONITOR_USER_AGENT=OpenClaw-Monitor/1.0 # HTTP User-Agent for monitoring

# ─── Workspaces ──────────────────────────────────────────────────────────────
# OPENCLAW_WORKSPACES=main              # Comma-separated workspace names
# OPENCLAW_SHARE_DIR=shared/personal    # Personal share directory
